# GraphQL API. Server-side only — the browser never calls it directly.
GRAPHQL_ENDPOINT=http://localhost:4000/api/graphql

# Canonical URL, used for metadata, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret between this app and the GraphQL API. Must match the backend's
# ADMIN_API_TOKEN exactly. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Auth.js session signing key. Generate with: openssl rand -hex 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# GitHub OAuth app — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Who may reach /admin. Comma-separated. If BOTH are empty, nobody can sign in.
# Use ADMIN_GITHUB_LOGINS when your GitHub email is private.
ADMIN_EMAILS=
ADMIN_GITHUB_LOGINS=
